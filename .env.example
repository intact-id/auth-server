# ─── Docker ────────────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your_dockerhub_username

# ─── Spring Profile ────────────────────────────────────────────────────────────
# Use "dev" locally, "prod" on the VPS
SPRING_PROFILES_ACTIVE=prod

# ─── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Database ──────────────────────────────────────────────────────────────────
# DB_HOST must be the container name of your postgres service on app-net
DB_HOST=postgres
DB_PORT=5432
DB_NAME=intact_id
DB_USERNAME=postgres
DB_PASSWORD=change_me

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change_me

# ─── Mail (SMTP) ───────────────────────────────────────────────────────────────
# Gmail: enable 2FA → myaccount.google.com/apppasswords → generate App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ─── CORS ──────────────────────────────────────────────────────────────────────
# ⚠ LIST — comma-separated, no spaces between entries
# Example: https://intact-id.com,https://dashboard.intact-id.com
CORS_ALLOWED_ORIGINS=https://intact-id.com,https://dashboard.intact-id.com

# ─── Branding / Contact ────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@intact-id.com
APP_BASE_URL=https://intact-id.com
TRACK_URL=https://id.intact-io.com
DASHBOARD_URL=https://dashboard.intact-id.com
DOCS_URL=https://docs.intact-id.com

# ─── Document Storage ──────────────────────────────────────────────────────────
# Must match the bind mount in docker-compose.yml
APP_DOCUMENTS_BASE_DIR=/var/data/intact-id/uploads

# ─── Face Screening Service ────────────────────────────────────────────────────
# FACE_SERVICE_URL must use the container name on app-net, port 9000
FACE_SERVICE_URL=http://face-service:9000
FACE_SERVICE_API_KEY=change_me
FACE_SERVICE_API_SECRET=change_me

# ─── OCR Service ───────────────────────────────────────────────────────────────
# OCR_SERVICE_URL must use the container name on app-net
OCR_SERVICE_URL=http://paddleocr-service:8000
OCR_SERVICE_API_KEY=change_me
OCR_SERVICE_API_SECRET=change_me
# Optional tuning — defaults are 0.65 and 0.85
# OCR_CONFIDENCE_THRESHOLD=0.65
# OCR_NAME_SIMILARITY_THRESHOLD=0.85
